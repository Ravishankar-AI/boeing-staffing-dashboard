// Boeing staffing dashboard schema.
//
// Lives in the same Railway Postgres database as the Objectways Data catalog,
// but in its own Postgres schema ("staffing") so the two apps' Prisma
// migrations never see — or try to drop — each other's tables. Select it by
// appending `?schema=staffing` to DATABASE_URL (see .env.example).
//
// Fields documented as enums are plain Strings, matching the catalog app's
// convention; allowed values are enforced in src/lib/staffing.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  // "admin" | "recruiter" | "client" — assigned by an admin on approval.
  role         String
  // Display only, e.g. "Objectways" or "Boeing".
  company      String
  // "pending" (registered, awaiting approval) | "active" | "disabled".
  // Only active users can sign in.
  status       String        @default("active")
  // scrypt hash, see src/lib/passwords.ts. Null for seeded placeholder users.
  passwordHash String?
  lastLoginAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  activity     ActivityLog[]
}

// Append-only record of who did what, shown to admins at /activity.
model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  // Kept even if the user is later renamed, and set for failed sign-ins
  // where there is no user (holds the email that was tried).
  actor     String
  // "sign_in" | "sign_in_failed" | "sign_out" | "register" | "approve" |
  // "reject" | "disable" | "enable" | "role_change" | "stage_change" |
  // "submission_create" | "submission_update" | "submission_delete" |
  // "resume_upload" | "resume_remove" | "resume_download" |
  // "position_update" | "position_create" | "cr_create" | "cr_update" |
  // "cr_delete" | "owner_create" | "email_import" | "email_dismiss" |
  // "inbox_sync" (older rows may say "engagement_*")
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A Boeing change request (e.g. "CR04", or the base "TOR 6131" scope).
// Several business owners can sit on one CR, and one owner can have
// several CRs; each opening belongs to one CR and (usually) one owner.
model ChangeRequest {
  id        String               @id @default(cuid())
  // Short identifier shown everywhere and used in dashboard filter URLs.
  code      String               @unique
  // Optional longer description.
  title     String?
  createdAt DateTime             @default(now())
  owners    ChangeRequestOwner[]
  positions Position[]
}

// A Boeing business owner / point of contact.
model BusinessOwner {
  id        String               @id @default(cuid())
  name      String               @unique
  createdAt DateTime             @default(now())
  crs       ChangeRequestOwner[]
  positions Position[]
}

model ChangeRequestOwner {
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  changeRequestId String
  owner           BusinessOwner @relation(fields: [businessOwnerId], references: [id], onDelete: Cascade)
  businessOwnerId String

  @@id([changeRequestId, businessOwnerId])
}

model Position {
  id              String         @id @default(cuid())
  changeRequest   ChangeRequest  @relation(fields: [changeRequestId], references: [id])
  changeRequestId String
  // The Boeing business owner this opening reports to.
  owner           BusinessOwner? @relation(fields: [businessOwnerId], references: [id])
  businessOwnerId String?
  title           String
  // "US" | "India"
  location        String
  required        Int
  filled          Int            @default(0)
  // "open" | "on_hold" | "closed" (cancelled by the client). "Filled" is not
  // stored: it is derived when filled >= required (see openingState()).
  status          String         @default("open")
  // Boeing-side reviewer / hiring manager for this role.
  hiringManager   String?
  openedAt        DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  submissions     Submission[]
}

// One resume sent to Boeing for one position. The same person can be
// submitted to more than one position/change request, so this is keyed by
// submission, not by candidate.
model Submission {
  id              String      @id @default(cuid())
  position        Position    @relation(fields: [positionId], references: [id])
  positionId      String
  candidateName   String
  location        String
  sentAt          DateTime
  // "submitted" | "screen_rejected" | "shortlisted" | "interview_scheduled"
  // | "awaiting_feedback" | "on_hold" | "interview_rejected" | "selected"
  // | "onboarded" | "withdrawn"
  stage           String      @default("submitted")
  screeningNotes  String?
  interviewer     String?
  interviewAt     DateTime?
  feedback        String?
  onboardingNotes String?
  resume          ResumeFile?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([positionId])
  @@index([stage])
}

// The resume document for a submission (PDF or Word, max 10 MB), stored in
// Postgres so it is backed up with everything else and only reachable through
// the app's own access check (src/app/resumes/[id]/route.ts). Kept in its own
// table so list queries never load file bytes.
model ResumeFile {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String     @unique
  filename     String
  contentType  String
  size         Int
  data         Bytes
  uploadedBy   String
  uploadedAt   DateTime   @default(now())
}

// --- Mailbox import (src/lib/inbox.ts) ---------------------------------------
// Recruiters cc consulting@objectways.com when sending profiles to Boeing. The
// app reads that one mailbox (read-only, Microsoft Graph), Claude proposes a
// draft candidate per profile, and a recruiter confirms each draft before it
// becomes a Submission. Nothing from email reaches Boeing's view unconfirmed.

model InboundEmail {
  id          String            @id @default(cuid())
  // Microsoft Graph message id; each email is processed once.
  graphId     String            @unique
  subject     String
  fromName    String?
  fromAddress String?
  // "Name <address>, ..." of To + Cc, for display and owner matching.
  recipients  String
  receivedAt  DateTime
  bodyText    String
  // "parsed" (drafts made) | "no_profiles" | "error" | "done" (all drafts handled)
  status      String
  error       String?
  // Claude's one-line description of the email.
  summary     String?
  createdAt   DateTime          @default(now())
  attachments EmailAttachment[]
  drafts      EmailDraft[]

  @@index([receivedAt])
}

// A resume attached to an inbound email (same PDF/Word checks as uploads).
model EmailAttachment {
  id          String       @id @default(cuid())
  email       InboundEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId     String
  filename    String
  contentType String
  size        Int
  data        Bytes
  drafts      EmailDraft[]
}

model EmailDraft {
  id            String           @id @default(cuid())
  email         InboundEmail     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId       String
  candidateName String
  // Claude's suggested opening; the recruiter can change it before confirming.
  positionId    String?
  attachment    EmailAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  attachmentId  String?
  // Why Claude matched it this way, plus any duplicate warning.
  note          String?
  // "pending" | "confirmed" | "dismissed"
  status        String           @default("pending")
  submissionId  String?
  handledBy     String?
  handledAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([status])
}

// Small key/value store: last mailbox sync result and the sync lock.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}
