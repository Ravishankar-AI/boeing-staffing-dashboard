{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": [
      "npx prisma migrate deploy && npm run db:seed:if-empty"
    ],
    "startCommand": "npm start",
    "healthcheckPath": "/sign-in",
    "restartPolicyType": "ON_FAILURE"
  }
}
