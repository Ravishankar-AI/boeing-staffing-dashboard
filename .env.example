# --- Database (the same Railway Postgres the Objectways Data catalog uses) ---
# Use the catalog's connection string with `?schema=staffing` appended. The
# staffing tables (and this app's own Prisma migration history) live in that
# Postgres schema, so neither app's migrations can see or drop the other's
# tables in "public".
#
# On Railway, set this on the dashboard service as a reference variable:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}?schema=staffing
# For local dev / seeding from your machine, use the Postgres service's
# public URL (Postgres → Connect) with the same suffix.
DATABASE_URL="postgresql://postgres:PASSWORD@containers-usXX.railway.app:PORT/railway?schema=staffing"
